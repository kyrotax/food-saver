{
  "expo": {
    "name": "Fridgy",
    "slug": "fridgy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.foodsaver.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Food Saver needs camera access to scan grocery receipts.",
        "NSPhotoLibraryUsageDescription": "Food Saver needs photo library access to upload receipt images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.foodsaver.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Food Saver to access your camera to scan grocery receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Food Saver to access your photos to upload grocery receipts."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1DB954"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "http://192.168.1.4:8000/api",
      "eas": {
        "projectId": "food-saver-project-id"
      }
    },
    "packagerOpts": {
      "scheme": "exp"
    }
  }
}
